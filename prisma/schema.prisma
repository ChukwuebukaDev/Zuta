datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

//
// ENUMS
//

enum Role {
  BUYER
  DEALER
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum Status {
  AVAILABLE
  SOLD
}

enum DealerStatus {
  DRAFT
  PENDING
  APPROVED
  SUSPENDED
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocType {
  GOVT_ID
  BUSINESS_CARD
  CERTIFICATE
}

//
// MODELS
//

model VerificationRequest {
  id           String        @id @default(cuid())
  status       RequestStatus @default(SUBMITTED)
  legalName    String        // The "Anchor" for verification
  adminNotes   String?       // Why was it rejected?
  
  documents    VerificationDocument[]
  
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
}


model VerificationDocument {
  id        String   @id @default(cuid())
  type      DocType  // e.g., GOVT_ID, BUSINESS_CARD, REGISTRATION
  url       String   // S3/Uploadthing link
  
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id])
}


model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String? @db.VarChar(20)
  role          Role      @default(BUYER)
  isVerified    Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars Car[]
  dealerProfile DealerProfile?
  verificationRequest VerificationRequest?
  @@index([email])
}

model DealerProfile {
  id           String       @id @default(cuid())
  businessName String
  slug         String       @unique
  status       DealerStatus @default(DRAFT)
  
  // Branding Assets
  tagline      String?
  bio          String?
  logo         String?
  banner       String?
  
  // Settings
  website      String?
  
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Car {
  id   String @id @default(cuid())
  slug String @unique

  title       String
  description String?

  brand String
  model String
  year  Int
  color String?

  bodyType     String
  transmission Transmission
  fuelType     FuelType
  drivetrain   String

  mileage   Int
  condition Condition

  accidentHistory Boolean @default(false)
  serviceHistory  Boolean @default(false)

  price      Int
  currency   String  @default("NGN")
  negotiable Boolean @default(false)

  thumbnail String

  status   Status  @default(AVAILABLE)
  featured Boolean @default(false)
  views    Int     @default(0)

  
  sellerName  String?
  sellerPhone String? @db.VarChar(20)
  sellerEmail String?

  city    String
  state   String
  country String @default("Nigeria")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  carImages CarImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([price])
  @@index([city])
  @@index([state])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model CarImage {
  id  String @id @default(cuid())
  url String

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([carId])
}
