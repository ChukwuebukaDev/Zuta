datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum Role {
  BUYER
  DEALER
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum Status {
  AVAILABLE
  SOLD
}

enum DealerStatus {
  DRAFT
  PENDING
  APPROVED
  SUSPENDED
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocType {
  GOVT_ID
  BUSINESS_CARD
  CERTIFICATE
}

// --- MODELS ---

model VerificationRequest {
  id         String                @id @default(cuid())
  status     RequestStatus         @default(SUBMITTED)
  legalName  String
  adminNotes String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  documents  VerificationDocument[]
  userId     String                @unique
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationDocument {
  id        String              @id @default(cuid())
  type      DocType
  url       String
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String?              @unique
  password           String?
  phone              String?
  role               Role                 @default(BUYER)
  isVerified         Boolean              @default(false)
  legalName          String?
  onboardingComplete Boolean              @default(false)
  idUrl              String?
  cardUrl            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  cars               Car[]
  dealerProfile      DealerProfile?
  verificationRequest VerificationRequest?
}

model DealerProfile {
  id           String       @id @default(cuid())
  businessName String
  slug         String       @unique
  status       DealerStatus @default(DRAFT)
  tagline      String?
  bio          String?
  logo         String?
  banner       String?
  website      String?
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Car {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String?      @db.Text
  brand           String
  model           String
  year            Int
  color           String       // Changed to required to match form
  bodyType        String
  transmission    Transmission
  fuelType        FuelType
  drivetrain      String
  mileage         Int
  condition       Condition
  accidentHistory Boolean      @default(false)
  serviceHistory  Boolean      @default(false)
  price           Int
  currency        String       @default("NGN")
  negotiable      Boolean      @default(false)
  thumbnail       String
  status          Status       @default(AVAILABLE)
  featured        Boolean      @default(false)
  views           Int          @default(0)
  
  // Seller Details
  sellerName      String?
  sellerPhone     String?      @db.VarChar(20)
  sellerEmail     String?

  // Location Fields (Option 1)
  city            String
  state           String
  country         String       @default("Nigeria")

  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  carImages       CarImage[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([price])
  @@index([city])
  @@index([state])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model CarImage {
  id        String   @id @default(cuid())
  url       String
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([carId])
}