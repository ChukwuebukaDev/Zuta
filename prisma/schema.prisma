generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Car {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  brand           String
  model           String
  year            Int
  bodyType        String
  transmission    String
  fuelType        String
  drivetrain      String
  mileage         Int
  condition       String
  accidentHistory Boolean   @default(false)
  serviceHistory  Boolean   @default(false)
  price           Int
  currency        String    @default("NGA")
  negotiable      Boolean   @default(false)
  thumbnail       String
  status          String   @default("available")
  featured        Boolean  @default(false)
  views           Int      @default(0)
  sellerName      String
  sellerPhone     String
  sellerEmail     String?
  location        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  carImages CarImage[]
}

model CarImage {
  id    String @id @default(cuid())
  url   String
  carId String
  car   Car    @relation(fields: [carId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}