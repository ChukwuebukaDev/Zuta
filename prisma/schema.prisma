generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String?        @unique
  password            String?
  phone               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  isVerified          Boolean        @default(false)
  isBanned            Boolean        @default(false)
  role                Role           @default(USER)
  onboardingComplete  Boolean        @default(false)
  fraudScore          Int            @default(0)
  fraudStatus         FraudStatus    @default(CLEAR)
  fraudEvents         FraudEvent[]
  favourites          Favorite[]
  cars                Car[]
  bookings            Booking[]
    verificationRequest VerificationRequest?
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  dealerProfile       DealerProfile?
  messages            Message[]
  privateListingLimit Int            @default(2)
  dealerReviews       DealerReview[]
}

model DealerProfile {
  id                  String               @id @default(cuid())
  businessName        String
  businessEmail       String?
  slug                String               @unique
  phone               String?
  tagline             String?
  bio                 String?
  logo                String?
  banner              String?
  website             String?
  status              DealerStatus         @default(DRAFT)
  listingLimits       Int                  @default(50)
  autoApproveListings Boolean              @default(false)
  rating              Float                @default(5)
  totalReviews        Int                  @default(0)
  responseRate        Float                @default(100)
  responseTime        Int                  @default(0)
  totalSales          Int                  @default(0)
  subscription        DealerSubscription?
  userId              String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews             DealerReview[]
}

model DealerSubscription {
  id               String           @id @default(cuid())
  dealerProfileId  String           @unique
  dealerProfile    DealerProfile    @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @default(FREE)
  active           Boolean          @default(true)
  startedAt        DateTime         @default(now())
  expiresAt        DateTime?
  autoRenew        Boolean          @default(false)
  paymentReference String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model DealerReview {
  id              String        @id @default(cuid())
  dealerProfileId String
  reviewerId      String
  rating          Int
  title           String?
  comment         String?
  createdAt       DateTime      @default(now())
  dealer          DealerProfile @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)
  reviewer        User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([dealerProfileId, reviewerId])
  @@index([dealerProfileId])
}

model VerificationRequest {
  id              String                 @id @default(cuid())
  legalName       String
  businessAddress String?
  cacNumber       String?                @unique
  status          RequestStatus          @default(SUBMITTED)
  adminNotes      String?
  userId          String                 @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  documents       VerificationDocument[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationDocument {
  id        String              @id @default(cuid())
  type      DocumentType // Fixed typo mismatch with enum DocumentType
  url       String
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Car {
  id              String         @id @default(cuid())
  sellerType      SellerType     @default(PRIVATE)
  title           String
  brand           String
  model           String
  year            Int
  price           Decimal        @db.Decimal(15, 2)
  mileage         Int
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  soldAt          DateTime?
  archivedAt      DateTime?
  updatedAt       DateTime       @updatedAt
  rejectedAt      DateTime?
  rejectionReason String?
  adminFeedback   String?
  accidentHistory Boolean        @default(false)
  bodyType        BodyType
  currency        String         @default("NGN")
  drivetrain      String
  featured        Boolean        @default(false)
  negotiable      Boolean        @default(false)
  serviceHistory  Boolean        @default(false)
  slug            String         @unique
  thumbnail       String
  views           Int            @default(0)
  color           String
  fuelType        FuelType
  trim            String?
  doors           Int?           @default(4)
  engineSize      String?
  engineCode      String?
  cylinders       Int?
  horsePower      Int?
  fuelCapacity    Float?
  seatingCapacity Int?
  transmission    Transmission
  condition       Condition
  status          CarStatus      @default(AVAILABLE)
  city            String
  country         String         @default("Nigeria")
  state           String
  description     String?
  userId          String
  listingStatus   ListingStatus  @default(PENDING)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  carImages       CarImage[]
  conversations   Conversation[]
  favourites      Favorite[]

  @@index([brand])
  @@index([model])
  @@index([price])
  @@index([city])
  @@index([state])
  @@index([listingStatus])
  @@index([sellerType])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model CarImage {
  id        String     @id @default(cuid())
  url       String
  carId     String
  createdAt DateTime   @default(now())
  angle     ImageAngle @default(OPTIONAL)
  car       Car        @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

/**
 * model CarValuation {
 * id           String       @id @default(cuid())
 * brand        String
 * model        String
 * year         Int
 * mileage      Int
 * transmission Transmission
 * fuelType     FuelType
 * condition    Condition
 * bodyType     String?
 * color        String?
 * state        String
 * city         String
 * estimatedMin Decimal      @db.Decimal(15, 2)
 * estimatedMax Decimal      @db.Decimal(15, 2)
 * confidence   Int?
 * userId       String?
 * email        String?
 * phone        String?
 * createdAt    DateTime     @default(now())
 * user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
 * @@index([userId])
 * }
 */

model Conversation {
  id        String    @id @default(cuid())
  carId     String
  buyerId   String
  sellerId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]

  @@unique([carId, buyerId, sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model ServiceProvider {
  id         String      @id @default(uuid())
  name       String
  type       ServiceType
  rating     Float       @default(5.0)
  location   String
  address    String
  phone      String
  image      String?
  priceFrom  Float
  isVerified Boolean     @default(false)
  createdAt  DateTime    @default(now())
  bookings   Booking[]
}

model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  score     Int
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Booking {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      BookingStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ImageAngle {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
  UNDERNEATH
  OPTIONAL
}

enum Role {
  USER
  DEALER
  PREMIUM_DEALER
  ADMIN
  SUPER_ADMIN
}

enum Transmission {
  // Traditional manual transmission operated by the driver.
  MANUAL

  // Manual gearbox where clutch engagement and gear changes are automated.
  AUTOMATED_MANUAL

  // Conventional automatic transmission with fixed gear ratios.
  AUTOMATIC

  // Continuously Variable Transmission with a continuously variable gear ratio.
  CVT

  // Dual-Clutch Transmission using two clutches for gear changes.
  DUAL_CLUTCH

  OTHER
}

enum FuelType {
  // Conventional gasoline/petrol-powered engine.
  PETROL

  // Conventional diesel-powered engine.
  DIESEL

  // Vehicle powered primarily by electricity using a battery and electric motor.
  ELECTRIC

  // Hybrid vehicle combining an internal combustion engine with an electric motor.
  HYBRID

  // Vehicle powered by compressed natural gas.
  CNG

}

enum BodyType {
  // Four-door passenger car with a separate trunk.
  SEDAN

  // Passenger car with a rear hatch and folding rear seats.
  HATCHBACK

  // Two-door passenger car with a fixed roof and sporty styling.
  COUPE

  // Vehicle with a retractable or removable roof.
  CONVERTIBLE

  // Sport Utility Vehicle with increased ground clearance.
  SUV

  // Car-based vehicle combining passenger-car handling with SUV characteristics.
  CROSSOVER

  // Multi-purpose vehicle with flexible seating and cargo capacity.
  MINIVAN

  // Vehicle primarily designed to transport passengers or cargo in an enclosed body.
  VAN

  // Vehicle with an open cargo bed behind the passenger cabin.
  PICKUP

  // High-performance passenger vehicle designed for speed and handling.
  SPORTS_CAR

  // Vehicle primarily designed for commercial transportation or heavy-duty work.
  TRUCK

  // Body type not covered by the standard categories.
  OTHER
}

enum DriveTrain {
  FWD
  RWD
  AWD
  FOUR_WD
}


enum Condition {
  NEW
  LOCAL_USED
  FOREIGN_USED
}

enum ListingStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SOLD
  ARCHIVED
}

enum CarStatus {
  AVAILABLE
  NEGOTIATING
  SOLD
  RESERVED
}

enum SellerType {
  PRIVATE
  DEALER
  PREMIUM_DEALER
}

enum DealerStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  GOVT_ID
  BUSINESS_CARD
  CAC_CERTIFICATE
}

enum ServiceType {
  MECHANIC
  CAR_WASH
  DETAILING
  TOWING
  INSPECTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FraudStatus {
  CLEAR
  REVIEW
  SUSPICIOUS
  FRAUD
}
