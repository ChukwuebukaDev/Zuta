generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  password            String?
  phone               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isVerified          Boolean              @default(false)
  role                Role                 @default(BUYER)
  cardUrl             String?
  idUrl               String?
  legalName           String?
  onboardingComplete  Boolean              @default(false)
  isBanned            Boolean  @default(false)
  fraudScore          Int      @default(0)
  fraudStatus         FraudStatus @default(CLEAR)
  fraudEvents         FraudEvent[]
  savedCarIds         String[]
  cars                Car[]
  bookings            Booking[]
  buyerConversations  Conversation[]       @relation("BuyerConversations")
  sellerConversations Conversation[]       @relation("SellerConversations")
  dealerProfile       DealerProfile?
  messages            Message[]
  verificationRequest VerificationRequest?
}

model DealerProfile {
  id           String       @id @default(cuid())
  businessName String
  slug         String       @unique
  phone        String?
  tagline      String?
  bio          String?
  logo         String?
  banner       String?
  website      String?
  status       DealerStatus @default(DRAFT)
  userId       String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id              String                 @id @default(cuid())
  legalName       String
  businessAddress String?
  cacNumber       String?                @unique
  status          RequestStatus          @default(SUBMITTED)
  adminNotes      String?
  userId          String                 @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  documents       VerificationDocument[]
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationDocument {
  id        String              @id @default(cuid())
  type      DocType
  url       String
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Car {
  id              String         @id @default(cuid())
  title           String
  brand           String
  model           String
  year            Int
  price           Int
  mileage         Int
  createdAt       DateTime       @default(now())
  accidentHistory Boolean        @default(false)
  bodyType        String
  currency        String         @default("NGN")
  drivetrain      String
  featured        Boolean        @default(false)
  negotiable      Boolean        @default(false)
  sellerEmail     String?
  sellerName      String?
  sellerPhone     String?        @db.VarChar(20)
  serviceHistory  Boolean        @default(false)
  slug            String         @unique
  thumbnail       String
  updatedAt       DateTime       @updatedAt
  views           Int            @default(0)
  color           String
  fuelType        FuelType
  transmission    Transmission
  condition       Condition
  status          Status         @default(AVAILABLE)
  city            String
  country         String         @default("Nigeria")
  description     String?
  state           String
  userId          String
  listingStatus   ListingStatus  @default(PENDING)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  carImages       CarImage[]
  conversations   Conversation[]

  @@index([price])
  @@index([city])
  @@index([state])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model CarImage {
  id        String     @id @default(cuid())
  url       String
  carId     String
  createdAt DateTime   @default(now())
  angle     ImageAngle @default(OPTIONAL)
  car       Car        @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
}

model Conversation {
  id        String    @id @default(cuid())
  carId     String
  buyerId   String
  sellerId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]

  @@unique([carId, buyerId, sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model ServiceProvider {
  id          String        @id @default(uuid())
  name        String        // e.g., "Matrix Premium Detailing"
  type        ServiceType
  rating      Float         @default(5.0)
  location    String        // City / Area
  address     String
  phone       String
  image       String?       // Thumbnail via Uploadthing
  priceFrom   Float         // Base pricing tier indicator
  isVerified  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  bookings    Booking[]
}

model FraudEvent {
  id          String   @id @default(cuid())
  userId      String
  reason      String
  score       Int
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
model Booking {
  id                String          @id @default(uuid())
  userId            String          // The authenticated Buyer
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId        String
  provider          ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime        // Date and time of booking
  status            BookingStatus   @default(PENDING)
  notes             String?         // Car model or specific issue notes
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum ImageAngle {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
  UNDERNEATH
  OPTIONAL
}

enum Role {
  BUYER
  DEALER
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

enum Status {
  AVAILABLE
  SOLD
  PENDING
}

enum DealerStatus {
  DRAFT
  PENDING
  APPROVED
  SUSPENDED
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocType {
  GOVT_ID
  BUSINESS_CARD
  CAC_CERTIFICATE
}

enum ServiceType {
  MECHANIC
  CAR_WASH
  DETAILING
  TOWING
  INSPECTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FraudStatus {
  CLEAR
  REVIEW
  SUSPICIOUS
  FRAUD
}

