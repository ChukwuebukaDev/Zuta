datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Condition {
  NEW
  USED
  CERTIFIED
}

enum Status {
  AVAILABLE
  SOLD
}

model Car {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  brand           String
  model           String
  year            Int
  bodyType        String
  transmission    Transmission
  fuelType        FuelType
  drivetrain      String
  mileage         Int
  condition       Condition
  accidentHistory Boolean   @default(false)
  serviceHistory  Boolean   @default(false)
  price           Int
  currency        String    @default("NGN")
  negotiable      Boolean   @default(false)
  thumbnail       String
  status          Status    @default(AVAILABLE)
  featured        Boolean   @default(false)
  views           Int       @default(0)
  sellerName      String
  sellerPhone     String    @db.VarChar(20)
  sellerEmail     String?
  location        String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  carImages       CarImage[]

  @@index([price])
  @@index([location])
  @@index([createdAt])
  @@index([status])
}

model CarImage {
  id        String   @id @default(cuid())
  url       String
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  cars      Car[]
}